<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>IMSConfig</key>
	<dict>
		<key>Emergency</key>
		<dict>
			<key>RestrictedDomainMode</key>
			<true/>
		</dict>
		<key>Signaling</key>
		<dict>
			<key>RequiresIMSIInContactHeaderOfAnonymousEmergencyInvite</key>
			<true/>
		</dict>
	</dict>
	<key>EmergencyCalling</key>
	<dict>
		<key>EmergencyServiceSupportedWithFallbackSupport</key>
		<true/>
		<key>SwitchEmergencySubAfterFailures</key>
		<true/>
		<key>ChooseDialingSubWhenBothSubsAreNotPreferred</key>
		<true/>
		<key>ChooseDataSubWhenBothSubsArePreferred</key>
		<true/>
	</dict>
</dict>
</plist>
